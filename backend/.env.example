# ==========================================================================
# Office Device Monitor — Backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- HTTP server ---
PORT=3001

# --- Database (Supabase PostgreSQL) ---
# Use the Supabase "Connection string" (URI). For serverless/pooled access use
# the pooler URL (port 6543) and add ?pgbouncer=true. For migrations, Prisma
# also accepts DIRECT_URL (port 5432). Keep this SECRET.
# Example: postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?schema=public
# Put the REAL value in `.env` (git-ignored) — never in this committed example file.
DATABASE_URL=postgresql://postgres.bajqpdxlrtqafepuexer:QGZL,d9!M@zh%t7@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
# Optional direct (non-pooled) connection used for migrations only.
# DIRECT_URL=postgresql://user:password@host:5432/postgres?schema=public

# --- Dashboard / CORS ---
DASHBOARD_ORIGIN=http://localhost:3000

# --- Office hours & timezone ---
OFFICE_TIMEZONE=Asia/Dhaka
OFFICE_START_HOUR=9
OFFICE_END_HOUR=17

# --- Simulator (in-memory devices) ---
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=10000

# --- Alert evaluation (in-memory active alerts) ---
ALERT_EVALUATION_INTERVAL_MS=60000

# --- API docs (Swagger) ---
# When false, Swagger UI (/api/docs) and OpenAPI JSON (/api/docs-json) are NOT registered.
SWAGGER_ENABLED=true

# --- Authentication ---
# Generate strong random secrets, e.g. `openssl rand -hex 48`. If unset, a random
# per-process secret is used (tokens do not survive restart) — set these in prod.
JWT_ACCESS_SECRET=your_jwt_access_secret_hex_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_hex_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Cookie flags for the HttpOnly refresh token. Use secure=true behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Seeded users (idempotent). Choose your own strong passwords — never commit real ones.
SEED_ADMIN_NAME=Office Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_VIEWER_NAME=Office Viewer
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=viewer123

# --- Discord bot (optional — backend runs fine without these) ---
# Create a bot at https://discord.com/developers/applications
# Enable the "MESSAGE CONTENT INTENT" under Bot settings.

DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ALERT_CHANNEL_ID=channel_id
DISCORD_COMMAND_PREFIX=!
